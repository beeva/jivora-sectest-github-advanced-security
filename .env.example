# Template for .env.dev / .env.prod. Copy with `make env` and fill in.
# Required to boot: POSTGRES_*, DB_*, JWT_SECRET, ENCRYPTION_KEY,
# JIVORA_SESSION_SECRET, WEB_CUSTOMER_ROLE_ID, WEB_PRACTITIONER_ROLE_ID,
# ADMIN_EMAIL, ADMIN_PASSWORD.

NODE_ENV=development

POSTGRES_DB=jivora
POSTGRES_USER=jivora
POSTGRES_PASSWORD=
DB_HOST=db
DB_PORT=5432
DB_SSL=false
DB_SCHEMA_SYNC=true

# ENCRYPTION_KEY is forever. Changing it orphans all existing PHI.
JWT_SECRET=
ENCRYPTION_KEY=
JIVORA_SESSION_SECRET=

WEB_CUSTOMER_ROLE_ID=4
WEB_PRACTITIONER_ROLE_ID=3

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional integrations. Each feature stays inert until set.
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
ACCOUNT_SID=
AUTH_TOKEN=
SMS_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
FROM=

WEB_APP_URL=http://localhost:4000
BACKEND_PUBLIC_URL=http://localhost:7002
CORS_ORIGIN=http://localhost:4000,http://localhost:4002
